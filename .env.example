# ========================================
# KONFIGURASI SISTEM WISUDA
# ========================================

APP_NAME="Sistem Wisuda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_wisuda
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# MAIL CONFIGURATION (Gmail SMTP)
# ========================================
# Untuk menggunakan Gmail, aktifkan "App Password" di akun Google Anda
# https://myaccount.google.com/apppasswords

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Email admin untuk menerima notifikasi pembayaran
ADMIN_EMAIL=admin@example.com

# ========================================
# MIDTRANS PAYMENT GATEWAY
# ========================================
# Dapatkan credentials di: https://dashboard.midtrans.com/
# Untuk testing, gunakan Sandbox credentials

MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ========================================
# SESSION & CACHE
# ========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# VITE
# ========================================
VITE_APP_NAME="${APP_NAME}"
